# Скопировать в .env и заполнить. Файл .env в Git не коммитится никогда.
#
# Живых токенов Wildberries здесь быть не должно: в базу едет ССЫЛКА на
# секрет (`secret_ref`), а значение достаётся через секрет-провайдер по
# WB_SECRET_DIR. Схема отбивает случайную запись JWT отдельным CHECK.

# Пароль базы shadow. Своей, не боевой и не стендовой.
SHADOW_POSTGRES_PASSWORD=

# Настоящий Wildberries. Обязателен, и это часть защиты: с пустым адресом
# сервис решит, что рядом симулятор, и запрет на запись в кабинет обойдётся.
WB_API_URL=https://marketplace-api.wildberries.ru

# РОВНО ОДИН кабинет — внешний идентификатор. Раздел 11: по одному, не пачкой.
# Пустое значение означает ВСЕ кабинеты, и преflight за это откажет.
SHADOW_WB_ACCOUNT=

# Доля бюджета лимита. Считает scripts/poll-budget.py по частоте опроса
# боевого шлюза (вопрос 11 раздела 13 — пока открыт, число спросить у
# владельца). Наугад не ставить: лимит 300/мин на кабинет ОБЩИЙ с боем.
SHADOW_POLL_INTERVAL_SECONDS=

# Каталог секрет-провайдера с токеном кабинета.
WB_SECRET_DIR=/run/secrets/wb

# Каталог с файлом токена на хосте. Монтируется контуру ТОЛЬКО НА ЧТЕНИЕ.
# Имя файла — `secret_ref` кабинета, приведённый к имени файла:
# `vault://mmx/wb/seller-42` → `mmx-wb-seller-42`.
#
# Каталог не в Git и не в репозитории. `chmod 700`, владелец — root.
WB_SECRET_HOST_DIR=/srv/mmwms-shadow-secrets

# Сервисный токен для вызовов на 127.0.0.1:18080 (завести клиента и кабинет).
# Тот же, что у сервиса: без него маршруты закрыты.
SHADOW_SERVICE_TOKEN=

# Состояния, которые сверка пропускает. `manual_review` — задание без
# маппинга товара: оно не обязано сходиться с WB, и без пропуска отчёт
# расхождений состоит из одних таких заданий.
WB_RECONCILE_SKIP_STATES=manual_review
