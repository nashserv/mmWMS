[Unit]
Description=mmWMS: полный прогон каждую ночь

[Timer]
# 04:00 по Москве — после ночной смены и до утренней. Склад в это время не
# работает, и нагрузочный шаг никому не мешает.
OnCalendar=*-*-* 04:00:00
Persistent=true
# Разброс в десять минут: если однажды таких стендов станет несколько, они не
# пойдут в базу одновременно.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
