# Скопировать в .env и заполнить. Файл .env в Git не коммитится никогда.
# Живых токенов Wildberries здесь быть не должно — token-guard не пустит
# стенд, если найдёт похожее на настоящий JWT (раздел 12 мастера).

POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?set outside Git}
RABBITMQ_USER=mmx
RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:?set outside Git}
GRAFANA_PASSWORD=${GRAFANA_PASSWORD:?set outside Git}
TRUSTED_HOSTS=localhost,127.0.0.1,wms,wb-simulator,testserver

# Целевой формат стикера. Откат на png, если реальный принтер не распознает
# ZPL — раздел 13, вопрос 2 пока открыт.
WB_STICKER_FORMAT=zplv
