# Боевой контур. НАСТОЯЩИЙ .env В GIT НЕ КЛАДЁТСЯ.
#
# Каждая переменная здесь обязательна: compose откажется подниматься без неё.
# Это намеренно — умолчание на бою означает «кто-то забыл, а контур встал и
# сделал что-то другое».

# Разрешение владельца на ЭТОТ шаг и ЭТОТ кабинет: что разрешено и когда.
# Раздел 12 требует его на каждое изменение боевого контура; преflight без
# этой строки контур не пустит.
PROD_OWNER_APPROVAL=

# Проверен ли формат этикетки на живом принтере (вопрос 2 раздела 13). На
# шаге 4 стикеры не запрашиваются — там годится «шаг 4, не требуется».
PROD_PRINTER_CONFIRMED=

POSTGRES_USER=wms
POSTGRES_PASSWORD=
SERVICE_DB_PASSWORD_WMS=
SERVICE_DB_PASSWORD_WORKSTATION=
SERVICE_DB_PASSWORD_BILLING=
SERVICE_DB_PASSWORD_IDENTITY=
SERVICE_DB_PASSWORD_PORTAL=
SERVICE_DB_PASSWORD_ADMIN=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

MMX_TENANT_ID=mm-express
SERVICE_TOKEN=
IDENTITY_SIGNING_KEY=
PRINT_AGENT_SECRET=

# Настоящий Wildberries. Пустой адрес сервис счёл бы за симулятор.
WB_API_URL=https://marketplace-api.wildberries.ru

# РОВНО ОДИН кабинет на шагах 4–5 (раздел 11). Не список.
PROD_WB_ACCOUNTS=

# Каталог с токенами кабинетов. Имя файла — secret_ref, приведённый к имени
# файла: из vault://mmx/wb/seller-42 получается mmx-wb-seller-42.
# Каталог не в Git и не в репозитории вовсе.
WB_SECRET_HOST_DIR=/srv/mmwms-secrets

# Частота опроса. Делится с боевым шлюзом: у кабинета 300 запросов в минуту
# ВСЕГО. Считает infrastructure/shadow/scripts/poll-budget.py --prod-rpm N.
# Вопрос 11 раздела 13 — без ответа владельца это число не назначить.
PROD_POLL_INTERVAL_SECONDS=

# Формат этикетки. Вопрос 2 раздела 13: проверить на живом XP-420B до шага 5.
WB_STICKER_FORMAT=zplv

PROD_TRUSTED_HOSTS=
PROD_BACKUP_DIR=/srv/mmwms-backups
BACKUP_KEEP_DAYS=45

# Куда alertmanager шлёт дежурному.
ALERTMANAGER_WEBHOOK=
