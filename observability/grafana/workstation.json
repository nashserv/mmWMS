        "x": 18,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mmx_workstation_tasks_diverged",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Воркеры: секунд с последнего шага (алерт на 900)",
      "description": "Инвариант 14: молчащий воркер считается сломанным. Четыре воркера боевого контура стояли Up с зелёным healthcheck и нулём строк лога.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "time() - max by (worker) (mmx_workstation_worker_last_processed_unixtime)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{worker}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Шина: подключена и сколько толчков даёт",
      "description": "Шина ускоряет экран, но источник истины — опрос. Ноль на верхнем графике — законное состояние: при выключенном RabbitMQ задания продолжают приходить.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mmx_workstation_bus_connected",
          "refId": "A",
          "datasource": {
