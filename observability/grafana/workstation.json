{
  "uid": "mmx-workstation",
  "title": "MM-Express — рабочее место сборщика и приёмщика",
  "description": "Поток B. Панели отвечают на вопрос «делается ли работа», а не «жив ли процесс»: мониторинг боевого контура следил за портами (раздел 3.5 мастера).",
  "tags": [
    "mmx",
    "workstation",
    "stream-b"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Полный путь задания: в wms → на экране",
      "description": "Три числа подряд. Расхождение между соседними — это «новые заказы иногда не падают в приложение», выраженное числом. Раньше его никто не считал.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mmx_workstation_tasks_available_in_wms",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "ждёт подбора в wms"
        },
        {
          "expr": "sum(mmx_workstation_tasks_on_screen)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "на экране"
        },
        {
          "expr": "mmx_workstation_tasks_pulled",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "забрано последним опросом"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Дыра между wms и экраном (цель — 0)",
      "description": "Задания, о которых wms знает, а экран нет. Критерий раздела 10: ноль потерянных между WB и экраном за неделю.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mmx_workstation_tasks_available_in_wms - sum(mmx_workstation_tasks_on_screen)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Задания на экране по статусу",
      "description": "Что сейчас в работе. Пустой экран при непустой очереди — авария, а не тишина.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mmx_workstation_tasks_on_screen",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{screen_status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Задержка «задание в wms → задание на экране», p99 (цель < 5 с)",
      "description": "Критерий раздела 10. Меряется от создания задания, а не от ответа сервера: иначе меряется скорость сети, а не то, сколько сборщик ждал работу.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mmx_workstation_task_visible_delay_seconds_bucket[10m])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Опрос /tasks/pull",
      "description": "Опрос — источник истины (раздел 6.1). Неудачные опросы означают, что экран показывает вчерашний день.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(mmx_workstation_polls_total[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Печать: нажатие → агент, p99 (цель < 50 мс)",
      "description": "Первая половина бюджета раздела 10. Больше 50 мс — на агента и принтер ничего не остаётся.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mmx_workstation_print_click_to_agent_seconds_bucket[10m])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Печать: запись в спулер, p99 (цель < 50 мс)",
      "description": "Вторая половина. Это число не может измерить никто, кроме агента станции: запись RAW-байтов в USB видна только на месте.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mmx_workstation_print_spooler_write_seconds_bucket[10m])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Агенты печати на связи (пять станций — пять агентов)",
      "description": "Принтеры USB, по одному на рабочее место (решение владельца 14). Ноль агентов означает, что печатать некуда.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mmx_workstation_print_agents_connected",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Контрольный скан при упаковке",
      "description": "Главный рубеж качества процесса (раздел 4): единственное место, где реально проверяется, что в коробке лежит то, что должно.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (scan_result) (increase(mmx_workstation_scans_total{stage=\"control\"}[1h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{scan_result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Сессии подбора (пять сборщиков — пять сессий)",
      "description": "В боевом контуре одна запись workstation_pick_session на 6497 заданий. Ноль сессий при непустой очереди означает подбор мимо системы.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mmx_workstation_pick_sessions_open",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Расхождение статуса с Wildberries",
      "description": "Инвариант 10: расхождение будит человека, а не пишется тихо. В боевом контуре 2467 таких заданий из 6374, и все молчали.",
      "gridPos": {
        "h": 7,
