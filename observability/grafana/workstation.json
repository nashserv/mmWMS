          },
          "legendFormat": "толчков в секунду"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Расхождение ответов wms с замороженным контрактом",
      "description": "Каждое чтение по запасной форме. Не авария, но и не норма: подстроиться молча значит выучить неправильный формат и обнаружить это в день переключения на настоящий сервис. Контракт меняется только потоком 0.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (route, field) (increase(mmx_workstation_contract_fallbacks_total[1h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
